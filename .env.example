# Firebase web config. authDomain must be the app's own hosting domain, so the
# sign-in redirect stays same-origin (Chrome blocks third-party storage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# "true" talks to the local Emulator Suite (pnpm emulators).
# For localhost with live Firebase, put the real project's web config and
# VITE_USE_EMULATORS=false in .env.development.local, then restart Vite.
# Demo API keys/project IDs only work with emulators. Live localhost sign-in
# uses a popup; add localhost to Firebase Authentication's authorized domains.
# On localhost, a configured <project>.web.app auth domain uses the project's
# default <project>.firebaseapp.com auth endpoint for the popup.
VITE_USE_EMULATORS=true
