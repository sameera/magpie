# Firebase web config. authDomain must be the app's own hosting domain, so the
# sign-in redirect stays same-origin (Chrome blocks third-party storage).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# "false" uses the live Firebase project. Authorize localhost in Firebase Auth
# for local development. "true" uses the Emulator Suite (pnpm emulators).
VITE_USE_EMULATORS=false
