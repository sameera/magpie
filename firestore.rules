rules_version = '2';

// Authorization layer. The app's sign-in gate is for convenience only.
// Membership records are created by the set-up step (scripts/setup-household.ts),
// never from the app.
service cloud.firestore {
    match /databases/{database}/documents {
        function memberPath() {
            return /databases/$(database)/documents/members/$(request.auth.uid);
        }

        function isMemberOf(householdId) {
            return request.auth != null
                && exists(memberPath())
                && get(memberPath()).data.householdId == householdId;
        }

        match /members/{uid} {
            allow read: if request.auth != null && request.auth.uid == uid;
            allow write: if false;
        }

        match /households/{householdId} {
            allow read: if isMemberOf(householdId);
            allow write: if false;

            // A member may create a store, create items and update an item.
            // Nothing else is written from the app: no deletes, no store edits
            // (bar the same-content retry of a save), no prices.
            function validName(data) {
                return data.name is string
                    && data.name.matches('.*[^\\s].*')
                    && data.name.size() <= 100;
            }

            match /stores/{storeId} {
                allow create: if isMemberOf(householdId)
                    && request.resource.data.keys().hasAll(['name', 'chain', 'map'])
                    && request.resource.data.keys().hasOnly(['name', 'chain', 'map'])
                    && validName(request.resource.data)
                    && request.resource.data.chain is string
                    && request.resource.data.chain.size() <= 100
                    && request.resource.data.map == null;

                // Retrying a save that already landed writes the same store again.
                allow update: if isMemberOf(householdId)
                    && request.resource.data == resource.data
                    && request.resource.data.keys().hasOnly(['name', 'chain', 'map'])
                    && request.resource.data.map == null;
            }

            // The household inventory. Photo and quantity remaining are set on
            // create. Photo and legacy places are not changed from the app; quantity
            // remaining changes only in a purchase (see isPurchase). The category is empty or one
            // of the six zone kinds (also listed in src/data/model.ts) or the key of a
            // custom category of the same household. The legacy
            // per-store placement (`places`) is not on a new item and is frozen
            // on an update of an item that still has it.
            match /items/{itemId} {
                function itemFields() {
                    return ['name', 'quantityNeeded', 'quantityRemaining', 'category', 'note', 'photoPath', 'onList'];
                }

                // None, a built-in category, or the key of a custom category that exists
                // in this household (one lookup, only for a custom key).
                function validCategory(data) {
                    return data.category == null
                        || data.category in ['produce', 'dairy', 'bakery', 'meat', 'frozen', 'pantry']
                        || (data.category is string
                            && data.category.size() >= 1
                            && data.category.size() <= 40
                            && exists(/databases/$(database)/documents/households/$(householdId)/categories/$(data.category)));
                }

                function validItem(data) {
                    return data.keys().hasAll(itemFields())
                        && data.keys().hasOnly(itemFields().concat(['places', 'purchaseCount', 'lastPurchasedAt', 'lastPurchaseId', 'preferredChain', 'typicalPurchaseQuantity']))
                        && data.get('typicalPurchaseQuantity', 1) is int
                        && data.get('typicalPurchaseQuantity', 1) >= 1
                        && data.get('typicalPurchaseQuantity', 1) <= 999
                        && (!data.keys().hasAny(['preferredChain'])
                            || (data.preferredChain is string
                                && data.preferredChain.size() <= 100
                                && data.preferredChain.matches('.*[^\\s].*')))
                        && data.get('purchaseCount', 0) is int
                        && data.get('purchaseCount', 0) >= 0
                        && validName(data)
                        && data.quantityNeeded is int
                        && data.quantityNeeded >= 1
                        && data.quantityNeeded <= 999
                        && data.quantityRemaining is int
                        && data.note is string
                        && data.note.size() <= 1000
                        && data.onList is bool
                        && (!data.keys().hasAny(['places']) || data.places is map)
                        && validCategory(data);
                }

                function unchanged(field) {
                    return request.resource.data.get(field, null) == resource.data.get(field, null);
                }

                allow create: if isMemberOf(householdId)
                    && validItem(request.resource.data)
                    && request.resource.data.quantityRemaining == 0
                    && !request.resource.data.keys().hasAny(['places'])
                    && request.resource.data.photoPath == null
                    && request.resource.data.get('purchaseCount', 0) == 0
                    && !request.resource.data.keys().hasAny(['lastPurchasedAt', 'lastPurchaseId']);

                // Edits and relisting leave inventory, photo and places as stored.
                function isEditOrRelist() {
                    return unchanged('photoPath')
                        && unchanged('quantityRemaining')
                        && unchanged('places')
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['purchaseCount', 'lastPurchaseId'])
                        && (unchanged('lastPurchasedAt')
                            || request.resource.data.get('lastPurchasedAt', null) == null
                            || (request.resource.data.lastPurchasedAt is timestamp
                                && request.resource.data.lastPurchasedAt <= request.time));
                }

                // A purchase takes an item that is on the list off it and adds a
                // whole number from 1 to 999 to inventory, changing nothing else.
                // The stored item must be on the list, so a resent, replayed or
                // concurrent second purchase of the same listing is refused.
                function isPurchase() {
                    let after = request.resource.data;
                    let entryPath = /databases/$(database)/documents/households/$(householdId)/purchases/$(after.lastPurchaseId);
                    let entry = getAfter(entryPath).data;
                    return resource.data.onList == true
                        && request.resource.data.onList == false
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['onList', 'quantityRemaining', 'purchaseCount', 'lastPurchasedAt', 'lastPurchaseId'])
                        && resource.data.quantityRemaining is int
                        && request.resource.data.quantityRemaining >= 0
                        && request.resource.data.quantityRemaining - resource.data.quantityRemaining >= 1
                        && request.resource.data.quantityRemaining - resource.data.quantityRemaining <= 999
                        && after.purchaseCount == resource.data.get('purchaseCount', 0) + 1
                        && after.lastPurchasedAt == request.time
                        && after.lastPurchaseId is string
                        && !exists(entryPath)
                        && entry.itemId == itemId
                        && entry.amount == after.quantityRemaining - resource.data.quantityRemaining
                        && entry.purchasedAt == request.time;
                }

                allow update: if isMemberOf(householdId)
                    && validItem(request.resource.data)
                    && (isEditOrRelist() || isPurchase());
            }

            // Custom categories. A member creates one under its key, the cleaned
            // name in lower case (see src/data/categoryName.ts). It is never
            // renamed or deleted; only a write of exactly what is stored is accepted,
            // so a retry, or the other member's identical offline save, is not an error.
            match /categories/{categoryId} {
                function reservedKeys() {
                    return ['produce', 'dairy', 'bakery', 'meat', 'frozen', 'pantry', 'no category'];
                }

                function validCategoryRecord(data) {
                    return data.keys().hasAll(['name'])
                        && data.keys().hasOnly(['name'])
                        && data.name is string
                        && data.name.size() >= 1
                        && data.name.size() <= 40
                        && data.name.matches('.*[\\p{L}\\p{N}].*')
                        && !data.name.matches('.*/.*')
                        && !data.name.matches('.*[^\\S ].*')
                        && !data.name.matches(' .*|.* |.*  .*')
                        // The rules lower-case ASCII only, so no capital outside ASCII.
                        && !data.name.matches('.*([^\\P{Lu}A-Z]|\\p{Lt}|\\p{Nl}).*')
                        && categoryId == data.name.lower()
                        && !(categoryId in reservedKeys());
                }

                allow create: if isMemberOf(householdId) && validCategoryRecord(request.resource.data);
                allow update: if isMemberOf(householdId)
                    && request.resource.data == resource.data
                    && validCategoryRecord(request.resource.data);
                allow delete: if false;
            }

            match /purchases/{purchaseId} {
                function validPurchase() {
                    let entry = request.resource.data;
                    let itemPath = /databases/$(database)/documents/households/$(householdId)/items/$(entry.itemId);
                    let before = get(itemPath).data;
                    let after = getAfter(itemPath).data;
                    return entry.keys().hasAll(['itemId', 'amount', 'purchasedAt'])
                        && entry.keys().hasOnly(['itemId', 'amount', 'purchasedAt'])
                        && entry.itemId is string
                        && entry.amount is int
                        && entry.amount >= 1 && entry.amount <= 999
                        && entry.purchasedAt == request.time
                        && before.onList == true && after.onList == false
                        && after.quantityRemaining == before.quantityRemaining + entry.amount
                        && after.purchaseCount == before.get('purchaseCount', 0) + 1
                        && after.lastPurchasedAt == request.time
                        && after.lastPurchaseId == purchaseId;
                }
                allow create: if isMemberOf(householdId) && validPurchase();
                allow update, delete: if false;
            }

            match /{document=**} {
                allow read: if isMemberOf(householdId);
                allow write: if false;
            }
        }
    }
}
