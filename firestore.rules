rules_version = '2';

// Authorization layer. The app's sign-in gate is for convenience only.
// Membership records are created by the set-up step (scripts/setup-household.ts),
// never from the app.
service cloud.firestore {
    match /databases/{database}/documents {
        function memberPath() {
            return /databases/$(database)/documents/members/$(request.auth.uid);
        }

        function isMemberOf(householdId) {
            return request.auth != null
                && exists(memberPath())
                && get(memberPath()).data.householdId == householdId;
        }

        match /members/{uid} {
            allow read: if request.auth != null && request.auth.uid == uid;
            allow write: if false;
        }

        match /households/{householdId} {
            allow read: if isMemberOf(householdId);
            allow write: if false;

            // A member may create a store, create items and update an item.
            // Nothing else is written from the app: no deletes, no store edits
            // (bar the same-content retry of a save), no prices.
            function validName(data) {
                return data.name is string
                    && data.name.matches('.*[^\\s].*')
                    && data.name.size() <= 100;
            }

            match /stores/{storeId} {
                allow create: if isMemberOf(householdId)
                    && request.resource.data.keys().hasAll(['name', 'chain', 'map'])
                    && request.resource.data.keys().hasOnly(['name', 'chain', 'map'])
                    && validName(request.resource.data)
                    && request.resource.data.chain is string
                    && request.resource.data.chain.size() <= 100
                    && request.resource.data.map == null;

                // Retrying a save that already landed writes the same store again.
                allow update: if isMemberOf(householdId)
                    && request.resource.data == resource.data
                    && request.resource.data.keys().hasOnly(['name', 'chain', 'map'])
                    && request.resource.data.map == null;
            }

            // The household inventory. Photo, quantity remaining and category are
            // set on create and not changed from the app yet.
            match /items/{itemId} {
                function itemFields() {
                    return ['name', 'quantityNeeded', 'quantityRemaining', 'category', 'note', 'photoPath', 'onList', 'places'];
                }

                function validItem(data) {
                    return data.keys().hasAll(itemFields())
                        && data.keys().hasOnly(itemFields())
                        && validName(data)
                        && data.quantityNeeded is int
                        && data.quantityNeeded >= 1
                        && data.quantityNeeded <= 999
                        && data.quantityRemaining is int
                        && data.note is string
                        && data.note.size() <= 1000
                        && data.onList is bool
                        && data.places is map;
                }

                function unchanged(field) {
                    return request.resource.data.get(field, null) == resource.data.get(field, null);
                }

                allow create: if isMemberOf(householdId)
                    && validItem(request.resource.data)
                    && request.resource.data.quantityRemaining == 0
                    && request.resource.data.category == null
                    && request.resource.data.photoPath == null;

                allow update: if isMemberOf(householdId)
                    && validItem(request.resource.data)
                    && unchanged('photoPath')
                    && unchanged('quantityRemaining')
                    && unchanged('category');
            }

            match /{document=**} {
                allow read: if isMemberOf(householdId);
                allow write: if false;
            }
        }
    }
}
