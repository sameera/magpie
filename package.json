{
    "name": "magpie",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b && tsc --noEmit -p tsconfig.node.json",
        "test": "pnpm typecheck && pnpm test:unit && pnpm test:rules",
        "test:unit": "vitest run",
        "test:rules": "firebase emulators:exec --only firestore,storage --project demo-magpie \"vitest run --config vitest.rules.config.ts\"",
        "emulators": "firebase emulators:exec --only auth,firestore,storage --project demo-magpie --ui \"tsx scripts/setup-household.ts --local && node -e 'setInterval(() => {}, 1 << 30)'\"",
        "setup:household": "tsx scripts/setup-household.ts"
    },
    "dependencies": {
        "firebase": "^12.19.0",
        "lucide-react": "^1.51.0",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-router": "^8.4.0"
    },
    "devDependencies": {
        "@firebase/rules-unit-testing": "^5.0.2",
        "@tailwindcss/vite": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "firebase-admin": "^14.5.0",
        "firebase-tools": "^15.32.1",
        "jsdom": "^30.1.1",
        "tailwindcss": "^4.3.3",
        "tsx": "^4.23.15",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "vite-plugin-pwa": "^2.0.0",
        "vitest": "^5.0.3"
    }
}
