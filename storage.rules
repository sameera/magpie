rules_version = '2';

service firebase.storage {
    match /b/{bucket}/o {
        match /households/{householdId}/{allPaths=**} {
            allow read: if request.auth != null
                && firestore.get(/databases/(default)/documents/members/$(request.auth.uid)).data.householdId == householdId;
            allow write: if false;
        }
    }
}
